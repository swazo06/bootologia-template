# Database
DATABASE_URL="postgresql://user:password@localhost:5432/social_template_automation?schema=public"

# Supabase Auth / Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth controls (never enable AUTH_BYPASS in production)
AUTH_BYPASS="false"
AUTH_BYPASS_ROLE="ADMIN"
CRON_SECRET="replace-with-long-random-cron-secret"

# Encryption (32-byte key as utf8/base64/hex — min 32 chars)
ENCRYPTION_KEY="replace-with-32-byte-secret-key!!"

# Meta Graph API
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v21.0"
META_GRAPH_TIMEOUT_MS="30000"
DRY_RUN="true"
ENABLE_META_PUBLISHING="false"
# Alias kept for compatibility (same meaning as ENABLE_META_PUBLISHING)
META_PUBLISH_ENABLED="false"
META_DEFAULT_ACCOUNT_ID="demo-account"
CSRF_SECRET="replace-with-csrf-hmac-secret-32ch"
OAUTH_STATE_SECRET="replace-with-oauth-state-secret-32"
API_RATE_LIMIT="120"
API_RATE_WINDOW_MS="60000"

# AI provider (OpenAI-compatible)
AI_PROVIDER="mock"
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL="gpt-4o-mini"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SCHEDULER_WORKER_ID="worker-local-1"
BRANDS_IN_MEMORY="true"
TEMPLATES_IN_MEMORY="true"
CONTENT_DRAFTS_IN_MEMORY="true"
PUBLICATIONS_IN_MEMORY="true"
SOCIAL_ACCOUNTS_IN_MEMORY="true"
