  "contentGeneration": {
    "input": {
      "requiredFields": [
        "brandId",
        "templateId",
        "topic",
        "objective",
        "targetAudience",
        "language"
      ],
      "optionalFields": [
        "offer",
        "mainMessage",
        "cta",
        "requiredInformation",
        "forbiddenInformation",
        "additionalInstructions",
        "imageSource"
      ]
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "headline",
        "subtitle",
        "cta",
        "caption",
        "hashtags",
        "imageDescription",
        "altText"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "cta": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "imageDescription": {
          "type": "string"
        },
        "altText": {
          "type": "string"
        }
      }
    },
    "systemPrompt": "Tu es un rédacteur spécialisé dans les publications Facebook et Instagram. Tu ne dois pas créer, modifier ou proposer une mise en page graphique. La mise en page est définie dans un canevas verrouillé. Ta mission consiste uniquement à produire les valeurs textuelles et descriptives nécessaires pour remplir les placeholders autorisés. Tu dois respecter exactement les limites du template. Tu ne dois inventer aucune donnée, aucun prix, aucun chiffre, aucun témoignage, aucun client, aucune statistique ni aucun résultat. Retourne uniquement un objet JSON valide correspondant au schéma demandé.",
    "userPromptTemplate": "Marque: {{BRAND_NAME}}\nDescription: {{BRAND_DESCRIPTION}}\nPublic cible: {{TARGET_AUDIENCE}}\nTon: {{TONE_OF_VOICE}}\nSujet: {{TOPIC}}\nObjectif: {{OBJECTIVE}}\nLangue: {{LANGUAGE}}\nInformations obligatoires: {{REQUIRED_INFORMATION}}\nInformations interdites: {{FORBIDDEN_INFORMATION}}\nContraintes du canevas: {{TEMPLATE_CONSTRAINTS}}\nGénère uniquement le contenu structuré destiné aux placeholders.",
    "hardRules": [
      "Le label doit respecter maxCharacters, maxWords et maxLines.",
      "Le titre doit respecter maxCharacters, maxWords et maxLines.",
      "Le sous-titre doit respecter maxCharacters, maxWords et maxLines.",
      "Le CTA doit respecter maxCharacters, maxWords et maxLines.",
      "La légende doit rester inférieure ou égale à 900 caractères.",
      "Le nombre de hashtags doit être compris entre 5 et 8.",
      "Aucune instruction graphique ne doit apparaître dans les textes.",
      "Le prompt d'image ne doit demander aucun texte dans l'image.",
      "Le prompt d'image ne doit pas demander de recréer un logo.",
      "Les mots interdits doivent être absents.",
      "Les termes obligatoires doivent être présents."
    ]
  },
  "qualityReportSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "passed",
      "spellingIssues",
      "unsupportedClaims",
      "brandViolations",
      "duplicatedIdeas",
      "overflowRisks",
      "recommendations"
    ],
    "properties": {
      "passed": {
        "type": "boolean"
      },
      "spellingIssues": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "unsupportedClaims": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "brandViolations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "duplicatedIdeas": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "overflowRisks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "severity"
          ],
          "properties": {
            "slidePosition": {
              "type": [
                "integer",
                "null"
              ]
            },
            "field": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            }
          }
        }
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "workflow": {
    "steps": [
      {
        "id": 1,
        "name": "SELECT_BRAND",
        "label": "Choisir la page ou la marque"
      },
      {
        "id": 2,
        "name": "SELECT_TEMPLATE",
        "label": "Choisir le canevas graphique verrouillé"
      },
      {
        "id": 3,
        "name": "ENTER_BRIEF",
        "label": "Saisir le sujet et l'objectif"
      },
      {
        "id": 4,
        "name": "SELECT_POST_TYPE",
        "label": "Choisir affiche ou carrousel"
      },
      {
        "id": 5,
        "name": "GENERATE_CONTENT",
        "label": "Générer uniquement le contenu"
      },
      {
        "id": 6,
        "name": "VALIDATE_CONTENT",
        "label": "Valider le contenu et les dimensions"
      },
      {
        "id": 7,
        "name": "RENDER_TEMPLATE",
        "label": "Remplir le canevas et générer le visuel"
      },
      {
        "id": 8,
        "name": "REVIEW",
        "label": "Prévisualiser et approuver"
      },
      {
        "id": 9,
        "name": "SCHEDULE",
        "label": "Choisir la date et l'heure"
      },
      {
        "id": 10,
        "name": "PUBLISH",
        "label": "Publier sur Facebook et Instagram"
      }
    ],
    "statusTransitions": {
      "DRAFT": [
        "GENERATING",
        "CANCELLED"
      ],
      "GENERATING": [
        "REVIEW",
        "FAILED"
      ],
      "REVIEW": [
        "APPROVED",
        "REJECTED"
      ],
      "REJECTED": [
        "DRAFT"
      ],
      "APPROVED": [
        "SCHEDULED",
        "PROCESSING"
      ],
      "SCHEDULED": [
        "PROCESSING",
        "CANCELLED"
      ],
      "PROCESSING": [
        "PUBLISHED",
        "FAILED"
      ],
      "FAILED": [
        "SCHEDULED",
        "CANCELLED"
      ],
      "PUBLISHED": []
    }
  },
