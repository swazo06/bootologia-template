{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": {
    "name": "social-template-automation",
    "displayName": "Social Template Automation",
    "version": "1.0.0",
    "language": "fr",
    "description": "Application de génération, validation, programmation et publication de contenus Facebook et Instagram à partir de canevas graphiques verrouillés.",
    "corePrinciple": "L'intelligence artificielle remplit le canevas. Elle ne crée jamais le canevas."
  },
  "cursor": {
    "recommendedMode": "agent",
    "executionStrategy": [
      "Lire entièrement cette spécification avant de modifier le code.",
      "Créer d'abord le plan d'implémentation et l'arborescence.",
      "Implémenter module par module.",
      "Après chaque module, exécuter type-check, lint et tests.",
      "Ne jamais considérer une fonctionnalité comme terminée si les tests échouent."
    ],
    "masterPrompt": "Tu es un ingénieur logiciel senior spécialisé en automatisation, génération de contenu, rendu graphique déterministe et publication sur les réseaux sociaux. Construis l'application décrite dans ce fichier JSON. Respecte strictement toutes les contraintes. L'application ne doit jamais inventer une mise en page. Les visuels sont créés uniquement à partir de templates SVG verrouillés et validés. L'IA génère uniquement du contenu structuré pour remplir les placeholders. Commence par produire un plan d'implémentation détaillé, puis implémente le projet par étapes. Après chaque étape, lance les vérifications prévues dans la section qualityGates."
  },
  "stack": {
    "runtime": "Node.js 20+",
    "framework": "Next.js App Router",
    "language": "TypeScript strict",
    "ui": [
      "Tailwind CSS",
      "shadcn/ui"
    ],
    "database": "PostgreSQL",
    "orm": "Prisma",
    "authentication": "Supabase Auth ou Auth.js",
    "storage": "Supabase Storage ou stockage S3 compatible",
    "imageProcessing": "Sharp",
    "validation": "Zod",
    "forms": "React Hook Form",
    "testing": [
      "Vitest",
      "Playwright"
    ],
    "scheduler": "n8n ou worker cron interne",
    "publishing": "Meta Graph API",
    "aiProvider": "Adapter interchangeable compatible avec une sortie JSON structurée"
  },
  "nonNegotiableRules": [
    "La mise en page ne doit jamais être générée par l'IA.",
    "Les positions, couleurs, polices, dimensions, marges et composants graphiques sont définis dans les templates.",
    "Les templates sources ne doivent jamais être modifiés pendant la génération.",
    "Chaque rendu doit utiliser une copie logique ou un rendu dérivé du template source.",
    "Aucun texte ne doit être intégré dans une image générée par IA.",
    "Aucun prix, chiffre, témoignage, client, résultat ou statistique ne doit être inventé.",
    "Un contenu ne peut pas être publié si son statut n'est pas APPROVED.",
    "Toute opération externe doit être idempotente.",
    "Les tokens et secrets ne doivent jamais apparaître dans les logs.",
    "Toutes les entrées et sorties externes doivent être validées avec Zod.",
    "Le mode DRY_RUN doit être disponible pour simuler les publications.",
    "Les tests ne doivent jamais publier réellement sur Facebook ou Instagram."
  ],
  "supportedContent": {
    "platforms": [
      "FACEBOOK",
      "INSTAGRAM"
    ],
    "postTypes": [
      "POSTER",
      "CAROUSEL"
    ],
    "formats": {
      "PORTRAIT": {
        "width": 1080,
        "height": 1350,
        "ratio": "4:5"
      },
      "SQUARE": {
        "width": 1080,
        "height": 1080,
        "ratio": "1:1"
      },
      "STORY": {
        "width": 1080,
        "height": 1920,
        "ratio": "9:16",
        "phase": "export-only"
      }
    },
    "languages": [
      "fr",
      "ar",
      "darija"
    ]
  },
  "projectStructure": {
    "folders": [
      "src/app",
      "src/components",
      "src/features/brands",
      "src/features/templates",
      "src/features/content-generation",
      "src/features/designs",
      "src/features/approvals",
      "src/features/calendar",
      "src/features/publishing",
      "src/features/integrations",
      "src/lib/auth",
      "src/lib/database",
      "src/lib/encryption",
      "src/lib/logging",
      "src/lib/validation",
      "src/providers/ai",
      "src/providers/meta",
      "src/providers/storage",
      "src/providers/scheduler",
      "src/server/actions",
      "src/server/services",
      "src/server/repositories",
      "src/types",
      "templates/brands",
      "tests/unit",
      "tests/integration",
      "tests/e2e",
      "docs"
    ]
  },
  "modules": {
    "TemplateRegistry": {
      "responsibilities": [
        "Charger les templates disponibles.",
        "Associer les templates à une marque.",
        "Valider la cohérence entre le fichier SVG et le fichier config.json.",
        "Vérifier que tous les placeholders déclarés existent.",
        "Empêcher l'utilisation d'un template archivé ou invalide."
      ]
    },
    "TemplateRenderer": {
      "responsibilities": [
        "Remplacer les placeholders de texte.",
        "Injecter les images.",
        "Gérer les retours à la ligne.",
        "Appliquer la taille de police autorisée.",
        "Convertir le SVG final en PNG ou JPG avec Sharp.",
        "Garantir des dimensions de sortie exactes.",
        "Produire une erreur explicite si le rendu est impossible."
      ]
    },
    "ContentGenerator": {
      "responsibilities": [
        "Construire le prompt à partir de la marque, du canevas et du brief.",
        "Demander uniquement du JSON structuré.",
        "Ne jamais demander une nouvelle mise en page.",
        "Retourner les champs correspondant exactement aux placeholders."
      ]
    },
    "ContentValidator": {
      "responsibilities": [
        "Valider la longueur des textes.",
        "Valider le nombre de mots.",
        "Valider le nombre de lignes.",
        "Détecter les champs manquants.",
        "Détecter les affirmations non vérifiables.",
        "Détecter les mots interdits.",
        "Vérifier les termes obligatoires.",
        "Bloquer le passage au statut REVIEW en cas d'erreur critique."
      ]
    },
    "TextFitService": {
      "responsibilities": [
        "Mesurer les dimensions du texte.",
        "Effectuer les retours à la ligne.",
        "Réduire la taille de police uniquement dans la plage autorisée.",
        "Refuser le contenu si le texte ne rentre toujours pas.",
        "Ne jamais modifier les coordonnées ou la taille de la zone de texte."
      ]
    },
    "ImageCropService": {
      "responsibilities": [
        "Vérifier le ratio minimal.",
        "Recadrer sans déformation.",
        "Respecter la zone focale.",
        "Conserver les dimensions exactes.",
        "Refuser les fichiers non supportés ou trop petits."
      ]
    },
    "DesignGenerationPipeline": {
      "steps": [
        "BRIEF_VALIDATION",
        "CONTENT_GENERATION",
        "CONTENT_QA",
        "ASSET_VALIDATION",
        "TEXT_FIT",
        "TEMPLATE_RENDER",
        "IMAGE_EXPORT",
        "STORAGE_UPLOAD",
        "PREVIEW_READY"
      ],
      "requirements": [
        "Chaque étape doit être journalisée.",
        "Chaque étape doit pouvoir reprendre après une erreur.",
        "Les étapes déjà réussies ne doivent pas être répétées sans nécessité.",
        "Une clé d'idempotence doit empêcher les générations en double.",
        "Le pipeline doit permettre de relancer une seule slide.",
        "Le pipeline doit conserver l'historique des versions."
      ]
    },
    "SocialPostScheduler": {
      "responsibilities": [
        "Enregistrer les dates en UTC.",
        "Afficher les dates dans la timezone de l'utilisateur.",
        "Réserver les publications à exécuter.",
        "Empêcher deux workers de publier le même contenu.",
        "Gérer les retries temporaires.",
        "Annuler les retries pour les erreurs définitives."
      ]
    },
    "MetaPublisher": {
      "responsibilities": [
        "Publier une image unique.",
        "Publier un carrousel.",
        "Valider les fichiers avant publication.",
        "Vérifier le statut du compte.",
        "Vérifier le token.",
        "Enregistrer l'identifiant externe.",
        "Fonctionner en DRY_RUN.",
        "Être entièrement mockable."
      ]
    }
  },
  "templateSystem": {
    "rootPath": "templates/brands",
    "exampleTree": {
      "botoschool": {
        "poster-service-v1": [
          "template.svg",
          "config.json",
          "preview.png"
        ],
        "carousel-educational-v1": [
          "slide-01.svg",
          "slide-02.svg",
          "slide-03.svg",
          "slide-04.svg",
          "slide-05.svg",
          "slide-06.svg",
          "config.json",
          "preview.png"
        ]
      }
    },
    "allowedDynamicFields": [
      "label",
      "headline",
      "subtitle",
      "body",
      "cta",
      "mainImage",
      "caption",
      "hashtags",
      "altText"
    ],
    "lockedProperties": [
      "canvasWidth",
      "canvasHeight",
      "elementCoordinates",
      "brandColors",
      "fontFamilies",
      "fontWeights",
      "fontSizeRanges",
      "margins",
      "safeZones",
      "logoPosition",
      "logoSize",
      "imageFrames",
      "decorativeElements",
      "slideNumberPosition"
    ],
    "placeholderSyntax": "{{FIELD_NAME}}",
    "forbiddenUserControls": [
      "freeColorPicker",
      "freeFontPicker",
      "freeElementPositioning",
      "freeLayoutGeneration",
      "freeDesignPrompt",
      "unrestrictedTemplateEditing"
    ]
  },
  "templateConfigExample": {
    "id": "poster-service-v1",
    "brand": "botoschool",
    "name": "Affiche service principale",
    "type": "POSTER",
    "status": "ACTIVE",
    "version": 1,
    "format": "PORTRAIT",
    "dimensions": {
      "width": 1080,
      "height": 1350
    },
    "source": {
      "svg": "template.svg",
      "preview": "preview.png"
    },
    "fonts": [
      {
        "family": "Inter",
        "required": true,
        "fallback": "Arial"
      }
    ],
    "colors": {
      "background": "#FFFFFF",
      "primary": "#111111",
      "secondary": "#666666",
      "accent": "#D7FF00"
    },
    "fields": {
      "label": {
        "type": "text",
        "required": true,
        "placeholder": "{{LABEL}}",
        "maxCharacters": 18,
        "maxWords": 3,
        "maxLines": 1,
        "fontSize": {
          "default": 24,
          "min": 22,
          "max": 24
        }
      },
      "headline": {
        "type": "text",
        "required": true,
        "placeholder": "{{HEADLINE}}",
        "maxCharacters": 42,
        "maxWords": 7,
        "maxLines": 3,
        "fontSize": {
          "default": 72,
          "min": 58,
          "max": 72
        }
      },
      "subtitle": {
        "type": "text",
        "required": true,
        "placeholder": "{{SUBTITLE}}",
        "maxCharacters": 110,
        "maxWords": 20,
        "maxLines": 4,
        "fontSize": {
          "default": 32,
          "min": 26,
          "max": 32
        }
      },
      "cta": {
        "type": "text",
        "required": true,
        "placeholder": "{{CTA}}",
        "maxCharacters": 20,
        "maxWords": 4,
        "maxLines": 1,
        "fontSize": {
          "default": 26,
          "min": 22,
          "max": 26
        }
      },
      "mainImage": {
        "type": "image",
        "required": true,
        "placeholder": "{{MAIN_IMAGE}}",
        "expectedRatio": "4:5",
        "minimumWidth": 800,
        "minimumHeight": 1000,
        "fit": "cover",
        "allowUpscale": false
      }
    },
    "export": {
      "format": "png",
      "quality": 100,
      "width": 1080,
      "height": 1350
    }
  },
  "carouselTemplates": {
    "educationalV1": {
      "slideCount": 6,
      "slideRoles": [
        {
          "position": 1,
          "role": "HOOK",
          "purpose": "Créer une accroche forte et immédiatement compréhensible."
        },
        {
          "position": 2,
          "role": "PROBLEM",
          "purpose": "Présenter le problème principal."
        },
        {
