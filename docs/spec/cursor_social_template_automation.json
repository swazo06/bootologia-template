  },
  "renderingRules": {
    "text": {
      "overflowStrategy": [
        "normaliser les espaces",
        "appliquer les retours à la ligne",
        "réduire la taille de police jusqu'à la valeur minimale autorisée",
        "refuser le rendu si le texte dépasse toujours la zone"
      ],
      "forbiddenStrategies": [
        "déplacer la zone de texte",
        "augmenter la largeur de la zone",
        "réduire la taille sous le minimum",
        "modifier la mise en page"
      ]
    },
    "images": {
      "allowedMimeTypes": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ],
      "forbiddenMimeTypes": [
        "image/svg+xml"
      ],
      "fit": "cover",
      "allowDistortion": false,
      "allowUpscale": false,
      "requirePublicUrlForPublishing": true
    },
    "export": {
      "poster": [
        "1080x1350",
        "1080x1080"
      ],
      "carousel": [
        "1080x1350",
        "1080x1080"
      ],
      "requireSameDimensionsForAllSlides": true,
      "requireAllSlidesBeforeScheduling": true
    }
  },
  "scheduler": {
    "pollingInterval": "1 minute",
    "sourceOfTruth": "Publication table",
    "selectionRule": "status = SCHEDULED and scheduledAt <= now",
    "locking": "transactional row locking with SKIP LOCKED when available",
    "retryPolicy": [
      {
        "attempt": 1,
        "delayMinutes": 1
      },
      {
        "attempt": 2,
        "delayMinutes": 5
      },
      {
        "attempt": 3,
        "delayMinutes": 15
      }
    ],
    "nonRetryableErrors": [
      "PERMISSION_DENIED",
      "ACCOUNT_DISCONNECTED",
      "CONTENT_DELETED",
